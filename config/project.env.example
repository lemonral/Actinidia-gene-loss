# Copy to config/project.env and adjust only local paths.
PROJECT_ROOT=.
DATA_ROOT=../actinidia_gene_loss_data
MAX_THREADS=10
BUSCO_LINEAGE=embryophyta_odb10

# Optional process-local Mihomo endpoint. Pass this value explicitly with
# --proxy and list only foreign hosts with --proxy-domain. The downloader
# ignores inherited system proxy variables. Never commit a subscription URL.
# MIHOMO_PROXY=http://127.0.0.1:7890
